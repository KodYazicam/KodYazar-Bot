# Discord bot token (never commit a real value)
TOKEN=
# Application (client) ID, a 17-20 digit snowflake
CLIENT_ID=
# Optional: register /ping in one guild while developing (global commands can
# take up to an hour to appear)
GUILD_ID=
# debug | info | warn | error
LOG_LEVEL=info
# Health server port; 0 picks an ephemeral port
PORT=3000
# Persistent state; SQLite database + WAL/SHM sidecars live here
DATA_DIR=./data
