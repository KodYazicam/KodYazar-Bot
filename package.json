{
  "name": "kodyazar-bot",
  "version": "0.1.0",
  "private": true,
  "description": "All-in-one Discord server bot: announcements, backups, roles, moderation, staff tracking, logging.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run clean && npm run build && node --test \"dist/tests/**/*.test.js\"",
    "start": "node --env-file-if-exists=.env dist/src/index.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "sparkcord": "github:KodYazicam/sparkcord#95601d108b548549e052fdafe22d6a8da0c6cd2b"
  }
}
